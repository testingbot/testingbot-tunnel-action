{
  "name": "testingbot-tunnel-action",
  "version": "2.0.0",
  "description": "Set up the TestingBot Test Environment",
  "homepage": "https://github.com/testingbot/testingbot-tunnel-action#readme",
  "bugs": {
    "url": "https://github.com/testingbot/testingbot-tunnel-action/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testingbot/testingbot-tunnel-action.git"
  },
  "scripts": {
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint 'src/**/*.ts'",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/main/index.js && esbuild src/post.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/post/index.js",
    "pretest": "npm run build:test",
    "test": "mocha",
    "build:test": "tsc -p tsconfig.test.json && cp src/options.json test-build/src/options.json",
    "test:e2e": "http-server ./test -p 8080 > /dev/null 2>&1 & node ./test/e2e.test.js",
    "all": "npm run build && npm run format && npm run lint && npm run test"
  },
  "author": "Jochen Delabie <jochen@testingbot.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "testingbot",
    "tunnel",
    "proxy",
    "testingbot-tunnel"
  ],
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/sinon": "^22.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "http-server": "^14.1.1",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "sinon": "^22.1.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "webdriverio": "^9.32.0"
  },
  "overrides": {
    "diff": ">=8.0.3",
    "serialize-javascript": ">=7.0.3",
    "undici": ">=7.0.0"
  },
  "dependencies": {
    "@actions/artifact": "^6.3.1",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0"
  }
}
